---
import SectionHeading from "./SectionHeading.astro";
import { techGroups } from "@/data/technologies";
import { useT, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}
const t = useT(Astro.props.locale);
---

<section id="technologies" tabindex="-1" aria-labelledby="tech-title" class="py-16 md:py-24">
  <div class="container-page">
    <SectionHeading index="02" title={t("tech.title")} headingId="tech-title">
      {t("tech.description")}
    </SectionHeading>

    <!-- Una fila por categoría: lectura rápida, sin cuadrícula interminable de tarjetas -->
    <dl class="border-b border-border">
      {
        techGroups.map((group) => (
          <div class="grid gap-3 border-t border-border py-5 md:grid-cols-[13rem_minmax(0,1fr)] md:items-baseline md:gap-8 md:py-6">
            <dt class="legend">{t(group.categoryKey)}</dt>
            <dd>
              <ul class="flex flex-wrap gap-x-7 gap-y-3">
                {group.items.map((item) => (
                  <li class="inline-flex items-center gap-2.5 text-[1.0625rem] text-foreground">
                    <item.icon className="size-[1.125rem] shrink-0 text-muted-foreground" aria-hidden="true" />
                    {item.name}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
