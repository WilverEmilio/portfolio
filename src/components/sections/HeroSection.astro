---
import { Image } from "astro:assets";
import { ArrowDown, ArrowUpRight, Download } from "lucide-react";
import { buttonVariants } from "@/lib/button-variants";
import { cn } from "@/lib/utils";
import { contourPaths } from "@/lib/contours";
import { useT, type Locale } from "@/i18n";
import photo from "@/assets/photo.png";

interface Props {
  locale: Locale;
}
const t = useT(Astro.props.locale);

// Coordenadas de Quetzaltenango (ubicación que ya figura en el portafolio).
const coordinates = "14.83° N · 91.52° W";
const contours = contourPaths({ count: 12, cx: 36, cy: 62, minR: 6, maxR: 64 });

const profiles = [
  { label: "GitHub", href: "https://github.com/WilverEmilio", external: true },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/wilver-emilio-xiá-ixcot-6aa7662b4/", external: true },
  { label: "Email", href: "mailto:ixcotwilver@gmail.com", external: false },
];
---

<section class="relative overflow-x-clip pt-28 pb-12 md:pt-36 md:pb-16">
  <div
    class="container-page grid items-start gap-x-16 gap-y-10 [grid-template-areas:'intro'_'photo'_'body'] lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:[grid-template-areas:'intro_photo'_'body_photo']"
  >
    <!-- Identidad -->
    <div class="[grid-area:intro]">
      <p class="legend flex flex-wrap items-center gap-x-3 gap-y-1">
        <span>{t("hero.location")}</span>
        <span aria-hidden="true" class="hidden h-px w-6 bg-border sm:block"></span>
        <span>{coordinates}</span>
      </p>
      <h1
        class="mt-6 text-[clamp(2.25rem,1.1rem+5vw,5.25rem)] leading-[0.98] font-bold tracking-[-0.025em] text-foreground"
      >
        Wilver Emilio Xiá Ixcot
      </h1>
      <p class="mt-5 flex items-center gap-3 font-display text-xl font-medium text-foreground md:text-2xl">
        <span aria-hidden="true" class="size-2 rounded-full bg-primary"></span>
        {t("hero.title")}
      </p>
    </div>

    <!-- Retrato: elemento distintivo (curvas de nivel) solo aquí -->
    <figure class="relative isolate w-full max-w-[18rem] [grid-area:photo] sm:max-w-sm lg:ml-auto lg:max-w-none lg:pt-2">
      <svg
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        aria-hidden="true"
        class="pointer-events-none absolute -top-14 -left-20 -z-10 h-[calc(100%+8rem)] w-[calc(100%+9rem)] text-contour [mask-image:radial-gradient(closest-side,#000_70%,transparent)]"
      >
        {contours.map((d) => <path d={d} fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />)}
      </svg>
      <div class="overflow-hidden rounded-lg border border-border bg-muted">
        <Image
          src={photo}
          alt={t("hero.photoAlt")}
          widths={[320, 400, 560, 720, 880]}
          sizes="(min-width: 1024px) 400px, (min-width: 640px) 384px, 288px"
          class="aspect-[4/5] h-auto w-full object-cover object-[50%_18%]"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption class="mt-3 flex items-center justify-between gap-4">
        <span class="inline-flex items-center gap-2 text-sm text-foreground">
          <span class="size-2 rounded-full bg-primary" aria-hidden="true"></span>
          {t("hero.available")}
        </span>
        <span class="legend" aria-hidden="true">Fig. 01</span>
      </figcaption>
    </figure>

    <!-- Presentación y acciones -->
    <div class="[grid-area:body] lg:-mt-2">
      <p class="max-w-[54ch] text-lg leading-relaxed text-muted-foreground text-pretty">
        {t("hero.description")}
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#projects" class={buttonVariants({ size: "lg" })}>
          {t("hero.viewProjects")}
          <ArrowDown aria-hidden="true" />
        </a>
        <a href="/cv-wilver.pdf" download class={buttonVariants({ variant: "outline", size: "lg" })}>
          <Download aria-hidden="true" />
          {t("hero.downloadCV")}
        </a>
      </div>

      <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 border-t border-border pt-6" aria-label={t("hero.social")}>
        {
          profiles.map((p) => (
            <li>
              <a
                href={p.href}
                {...(p.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                class="group inline-flex min-h-11 items-center gap-1 text-sm font-medium text-foreground underline-offset-4 hover:text-primary hover:underline"
              >
                {p.label}
                <ArrowUpRight
                  className={cn("size-3.5 text-muted-foreground transition-transform group-hover:text-primary motion-safe-hover", "group-hover:-translate-y-0.5 group-hover:translate-x-0.5")}
                  aria-hidden="true"
                />
                {p.external && <span class="sr-only">({t("projects.opensInNewTab")})</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
