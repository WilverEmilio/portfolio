---
import { ArrowUpRight } from "lucide-react";
import SectionHeading from "./SectionHeading.astro";
import ContactForm, { type ContactFormLabels } from "@/components/islands/ContactForm";
import { useT, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}
const t = useT(Astro.props.locale);

const formLabels: ContactFormLabels = {
  name: t("form.name"),
  email: t("form.email"),
  subject: t("form.assunto"),
  message: t("form.message"),
  placeholderName: t("form.label.name"),
  placeholderEmail: t("form.label.email"),
  placeholderSubject: t("form.label.subject"),
  placeholderMessage: t("form.label.message"),
  submit: t("form.submit"),
  sending: t("form.send1"),
  success: t("form.success"),
  error: t("form.error"),
  errorPrefix: t("form.errorPrefix"),
  errorName: t("form.error.name"),
  errorEmailMissing: t("form.error.emailMissing"),
  errorEmailFormat: t("form.error.emailFormat"),
  errorSubject: t("form.error.subject"),
  errorMessage: t("form.error.message"),
};

const channels = [
  { label: t("form.email"), value: "ixcotwilver@gmail.com", href: "mailto:ixcotwilver@gmail.com", external: false },
  { label: "LinkedIn", value: "Wilver Emilio Xiá Ixcot", href: "https://www.linkedin.com/in/wilver-emilio-xiá-ixcot-6aa7662b4/", external: true },
  { label: "GitHub", value: "@WilverEmilio", href: "https://github.com/WilverEmilio", external: true },
];
---

<section id="contact" tabindex="-1" aria-labelledby="contact-title" class="py-16 md:py-24">
  <div class="container-page">
    <SectionHeading index="04" title={t("contact.heading")} headingId="contact-title" />

    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
      <!-- Información y canales directos (HTML estático) -->
      <div>
        <p class="max-w-[46ch] text-lg leading-relaxed text-muted-foreground">{t("contact.description")}</p>

        <h3 class="legend mt-10 font-sans">{t("form.title1")}</h3>
        <dl class="mt-4 border-t border-border">
          {
            channels.map((c) => (
              <div class="flex flex-col gap-1 border-b border-border py-3.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <dt class="legend">{c.label}</dt>
                <dd class="min-w-0 sm:text-right">
                  <a
                    href={c.href}
                    {...(c.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                    class="group inline-flex min-h-6 items-center gap-1 break-all text-foreground underline-offset-4 hover:text-primary hover:underline"
                  >
                    {c.value}
                    {c.external && (
                      <>
                        <ArrowUpRight className="size-3.5 shrink-0 text-muted-foreground group-hover:text-primary" aria-hidden="true" />
                        <span class="sr-only">({t("projects.opensInNewTab")})</span>
                      </>
                    )}
                  </a>
                </dd>
              </div>
            ))
          }
          <div class="flex flex-col gap-1 border-b border-border py-3.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
            <dt class="legend">{t("form.title2")}</dt>
            <dd class="text-foreground sm:text-right">{t("form.location")}</dd>
          </div>
          <div class="flex flex-col gap-1 border-b border-border py-3.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
            <dt class="legend">{t("form.title3")}</dt>
            <dd class="inline-flex items-center gap-2 text-foreground sm:text-right">
              <span class="size-2 rounded-full bg-primary" aria-hidden="true"></span>
              {t("form.disponible")}
            </dd>
          </div>
        </dl>
      </div>

      <!-- Formulario: única parte interactiva → isla que se hidrata al acercarse -->
      <div class="rounded-lg border border-border bg-card p-5 sm:p-8">
        <ContactForm client:visible labels={formLabels} />
      </div>
    </div>
  </div>
</section>
