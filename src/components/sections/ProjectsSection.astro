---
import { Image } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import ProjectLinks from "./ProjectLinks.astro";
import { projects } from "@/data/projects";
import { useT, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured && p.status === "completed");
const inProgress = projects.filter((p) => p.status === "in-progress");
---

<section id="projects" tabindex="-1" aria-labelledby="projects-title" class="py-16 md:py-24">
  <div class="container-page">
    <SectionHeading index="03" title={t("projects.title")} headingId="projects-title">
      {t("projects.description")}
    </SectionHeading>

    <!-- Destacado: bloque grande, captura protagonista -->
    {
      featured.map((p) => (
        <article class="group grid gap-8 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-12" aria-labelledby={`p-${p.titleKey}`}>
          {p.image && (
            <div class="self-start overflow-hidden rounded-lg border border-border bg-muted">
              <Image
                src={p.image}
                alt={`${t("projects.screenshotAlt")} ${t(p.titleKey)}`}
                widths={[...new Set([480, 720, 960].map((w) => Math.min(w, p.image!.width)))]}
                sizes="(min-width: 1152px) 620px, (min-width: 1024px) 56vw, calc(100vw - 40px)"
                class="aspect-[16/10] h-auto w-full object-cover object-top transition-transform duration-500 ease-out motion-safe-hover [@media(pointer:fine)]:group-hover:scale-[1.02]"
                loading="lazy"
              />
            </div>
          )}
          <div class="flex flex-col">
            {p.badgeKey && <p class="legend text-primary">{t(p.badgeKey)}</p>}
            <h3 id={`p-${p.titleKey}`} class="mt-3 text-[1.75rem] leading-tight font-semibold tracking-tight text-foreground md:text-[2rem]">
              {t(p.titleKey)}
            </h3>
            <p class="mt-4 leading-relaxed text-muted-foreground">{t(p.descriptionKey)}</p>

            <dl class="mt-6 grid grid-cols-[auto_minmax(0,1fr)] gap-x-6 gap-y-2.5 border-t border-border pt-5 text-sm">
              {p.organizationKey && (
                <>
                  <dt class="legend leading-5">{t("projects.meta.organization")}</dt>
                  <dd class="text-foreground">{t(p.organizationKey)}</dd>
                </>
              )}
              {p.period && (
                <>
                  <dt class="legend leading-5">{t("projects.meta.period")}</dt>
                  <dd class="text-foreground">{p.period[locale]}</dd>
                </>
              )}
              <dt class="legend leading-5">{t("projects.meta.status")}</dt>
              <dd class="text-foreground">{t("projects.status.completed")}</dd>
              <dt class="legend leading-5">{t("projects.meta.stack")}</dt>
              <dd class="font-mono text-[0.8125rem] leading-6 text-muted-foreground">{p.skills.join(" · ")}</dd>
            </dl>

            <ProjectLinks project={p} locale={locale} class="mt-6" />
          </div>
        </article>
      ))
    }

    <!-- Resto de proyectos y proyectos en desarrollo: menor peso visual -->
    {
      (rest.length > 0 || inProgress.length > 0) && (
        <div class="mt-14 grid gap-14 border-t border-border pt-14 md:mt-20 md:pt-16">
          {rest.map((p) => (
            <article class="group grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-10" aria-labelledby={`p-${p.titleKey}`}>
              {p.image && (
                <div class="self-start overflow-hidden rounded-lg border border-border bg-muted">
                  <Image
                    src={p.image}
                    alt={`${t("projects.screenshotAlt")} ${t(p.titleKey)}`}
                    widths={[...new Set([400, 640, 900].map((w) => Math.min(w, p.image!.width)))]}
                    sizes="(min-width: 1152px) 540px, (min-width: 768px) 46vw, calc(100vw - 40px)"
                    class="aspect-[16/9] h-auto w-full object-cover object-top transition-transform duration-500 ease-out motion-safe-hover [@media(pointer:fine)]:group-hover:scale-[1.02]"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="flex flex-col">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  {p.badgeKey && <p class="legend">{t(p.badgeKey)}</p>}
                  {p.period && <p class="legend">{p.period[locale]}</p>}
                </div>
                <h3 id={`p-${p.titleKey}`} class="mt-3 text-[1.5rem] leading-tight font-semibold tracking-tight text-foreground">
                  {t(p.titleKey)}
                </h3>
                {p.organizationKey && <p class="mt-1 text-sm text-muted-foreground">{t(p.organizationKey)}</p>}
                <p class="mt-3 leading-relaxed text-muted-foreground">{t(p.descriptionKey)}</p>
                <p class="mt-4 font-mono text-[0.8125rem] leading-6 text-muted-foreground">{p.skills.join(" · ")}</p>
                <ProjectLinks project={p} locale={locale} class="mt-5" />
              </div>
            </article>
          ))}

          {inProgress.map((p) => (
            <article
              class="flex flex-col rounded-lg border border-dashed border-signal/60 bg-signal-soft/40 p-6 md:p-8"
              aria-labelledby={`p-${p.titleKey}`}
            >
              <p class="inline-flex items-center gap-2 self-start rounded-sm bg-signal-soft px-2 py-1 font-mono text-xs tracking-[0.12em] text-signal uppercase">
                <span class="size-1.5 rounded-full bg-signal" aria-hidden="true" />
                {t("projects.status.inProgress")}
              </p>
              <h3 id={`p-${p.titleKey}`} class="mt-5 text-[1.375rem] leading-tight font-semibold tracking-tight text-foreground">
                {t(p.titleKey)}
              </h3>
              <p class="mt-3 leading-relaxed text-muted-foreground">{t(p.descriptionKey)}</p>
              <p class="mt-4 font-mono text-[0.8125rem] leading-6 text-muted-foreground">{p.skills.join(" · ")}</p>
              <ProjectLinks project={p} locale={locale} class="mt-5" />
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
