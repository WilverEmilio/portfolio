---
import { Image } from "astro:assets";
import { ExternalLink, Github } from "lucide-react";
import type { Project } from "@/data/projects";
import { useT, type Locale } from "@/i18n";

interface Props {
  project: Project;
  locale: Locale;
}
const { project, locale } = Astro.props;
const t = useT(locale);
const title = t(project.titleKey);
const organization = project.organizationKey ? t(project.organizationKey) : undefined;
const { badge, period, skills, githubUrl, githubUrls, liveUrl, liveUrls } = project;
---

<div class="group relative rounded-2xl bg-card border-2 border-foreground/15 dark:border-border shadow-md dark:shadow-none hover:border-primary/50 hover:shadow-2xl hover:shadow-[0_0_30px_rgba(20,184,166,0.4)] dark:hover:shadow-[0_0_30px_rgba(20,184,166,0.6)] transition-all duration-300 overflow-hidden hover:-translate-y-2">
  {
    badge && (
      <div class="absolute top-4 left-4 z-10">
        <span class="px-3 py-1.5 rounded-full text-xs font-semibold bg-primary text-primary-foreground shadow-lg">
          {badge}
        </span>
      </div>
    )
  }

  <!-- Imagen: el contenedor fija la proporción 16:9 y object-cover recorta igual que next/image fill -->
  <div class="relative aspect-video w-full overflow-hidden">
    <Image
      src={project.image}
      alt={`Preview of ${title}`}
      widths={[...new Set([400, 800, 1120].map((w) => Math.min(w, project.image.width)))]}
      sizes="(min-width: 1184px) 560px, (min-width: 768px) calc(50vw - 40px), calc(100vw - 48px)"
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-card via-transparent to-transparent opacity-60"></div>
  </div>

  <div class="p-6">
    <h3 class="text-xl font-bold text-foreground mb-2 group-hover:text-accent transition-colors">
      {title}
    </h3>

    {
      (organization || period) && (
        <div class="flex flex-wrap items-center gap-2 mb-3 text-xs text-muted-foreground">
          {organization && (
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
              </svg>
              {organization}
            </span>
          )}
          {organization && period && <span>•</span>}
          {period && (
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
              {period}
            </span>
          )}
        </div>
      )
    }

    <p class="text-muted-foreground text-sm leading-relaxed mb-4 line-clamp-3">
      {t(project.descriptionKey)}
    </p>

    <div class="flex flex-wrap gap-2 mb-5">
      {
        skills.map((skill) => (
          <span class="text-xs font-medium px-3 py-1 rounded-full bg-primary/10 text-primary border border-primary/30">{skill}</span>
        ))
      }
    </div>

    <div class="space-y-3">
      {
        githubUrls && githubUrls.length > 0 && (
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs text-muted-foreground font-medium">Código:</span>
            {githubUrls.map((repo) => (
              <a
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-background border border-primary/30 text-primary hover:bg-primary hover:text-primary-foreground transition-all text-xs font-medium"
              >
                <Github className="w-3.5 h-3.5" />
                {repo.label}
              </a>
            ))}
          </div>
        )
      }

      {
        !githubUrls && githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-background border border-primary/30 text-primary hover:bg-primary hover:text-primary-foreground transition-all text-sm font-medium"
          >
            <Github className="w-4 h-4" />
            Código
          </a>
        )
      }

      {
        liveUrls && liveUrls.length > 0 && (
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs text-muted-foreground font-medium">Demo:</span>
            {liveUrls.map((demo) => (
              <a
                href={demo.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-all text-xs font-medium"
              >
                <ExternalLink className="w-3.5 h-3.5" />
                {demo.label}
              </a>
            ))}
          </div>
        )
      }

      {
        !liveUrls && liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-all text-sm font-medium"
          >
            <ExternalLink className="w-4 h-4" />
            Ver Demo
          </a>
        )
      }
    </div>
  </div>
</div>
